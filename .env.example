# Server
PORT=8080
HOSTNAME=localhost
NODE_ENV=development
# Số reverse proxy đứng trước backend (xem README); proxy ngoài cùng phải ghi đè X-Forwarded-For
TRUST_PROXY=1
# Origin của frontend (nhiều origin cách nhau bằng dấu phẩy; origin đầu tiên dùng cho link Stripe trả về)
CLIENT_URL=http://localhost:3000

# Khoá bí mật dùng chung với frontend (API_INTERNAL_KEY) để request từ server Next không bị rate limit chung một IP
INTERNAL_API_KEY=change-me-internal

# Database
DATABASE_URL=mysql://user:password@localhost:3306/rental_cars

# JWT — hai secret phải khác nhau
ACCESS_TOKEN_SECRET=change-me-access
REFRESH_TOKEN_SECRET=change-me-refresh

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
# Lấy từ `stripe listen --forward-to localhost:8080/api/v1/stripe/webhook` khi chạy local
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
